# Copy to .env and fill in. NEVER commit or share this file.
# Kraken API key: Query Funds + Query Open Orders & Trades + Query Closed Orders & Trades
#                 + Create & Modify Orders + Cancel/Close Orders. NO withdrawal permission.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# Telegram control + trade alerts (get token from @BotFather, chat id from @userinfobot)
FREQTRADE__TELEGRAM__ENABLED=false
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# LIVE SWITCH. true = paper trading (start here). false = real money.
FREQTRADE__DRY_RUN=true
