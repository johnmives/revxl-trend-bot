{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "revxl-regime",
  "strategy": "RevXLRegime",
  "max_open_trades": 3,
  "stake_currency": "USD",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.98,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 300,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "spot",
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "emergency_exit": "market",
    "force_exit": "market",
    "force_entry": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },
  "exchange": {
    "name": "kraken",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "BTC/USD",
      "ETH/USD",
      "SOL/USD"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": "",
    "notification_settings": {
      "entry_fill": "on",
      "exit_fill": "on",
      "protection_trigger_global": "on"
    }
  },
  "initial_state": "running",
  "internals": {
    "process_throttle_secs": 5
  },
  "db_url": "sqlite:////freqtrade/user_data/tradesv3.sqlite"
}